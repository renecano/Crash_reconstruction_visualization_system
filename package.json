{
  "name": "croquis",
  "version": "0.1.0",
  "private": true,
  "description": "Reconstrucción 3D de percances viales a partir del relato de quien los vivió.",
  "license": "MIT",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @croquis/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r --workspace-concurrency=2 lint",
    "typecheck": "pnpm -r --workspace-concurrency=2 typecheck",
    "test": "pnpm -r --workspace-concurrency=2 test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@fontsource-variable/anybody": "5.3.0",
    "@gltf-transform/cli": "4.5.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "esbuild": "0.28.2",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
