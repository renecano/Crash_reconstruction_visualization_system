{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://croquis.mx/schemas/escena/1.0.0/escena.schema.json",
  "title": "EscenaSpec",
  "description": "Escena estructurada de un percance vial, producida por el extractor LLM o editada por la persona. Es el único contrato entre extracción, croquis 2D, solver y visor. Cada dato lleva su procedencia (fuente, confianza y evidencia del relato). Unidades: el solver normaliza a SI; la interfaz muestra km/h y metros. Marco de referencia: metros, eje X al este, eje Y al norte, rumbo en grados desde +X en sentido antihorario.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "lugar",
    "entorno",
    "vehiculos",
    "personas",
    "eventos",
    "danos_declarados",
    "evidencias"
  ],
  "properties": {
    "meta": { "$ref": "#/$defs/Meta" },
    "lugar": { "$ref": "#/$defs/Lugar" },
    "entorno": { "$ref": "#/$defs/Entorno" },
    "vehiculos": {
      "type": "array",
      "description": "Vehículos involucrados, incluidos los que no chocaron pero influyen (p. ej. uno estacionado va en entorno.objetos).",
      "items": { "$ref": "#/$defs/Vehiculo" },
      "minItems": 0,
      "maxItems": 8
    },
    "personas": {
      "type": "array",
      "description": "Personas involucradas, sin nombres ni datos personales.",
      "items": { "$ref": "#/$defs/Persona" },
      "maxItems": 32
    },
    "eventos": {
      "type": "array",
      "description": "Secuencia temporal de lo que pasó. El evento de impacto principal tiene t = 0.",
      "items": { "$ref": "#/$defs/Evento" },
      "maxItems": 32
    },
    "danos_declarados": {
      "type": "array",
      "items": { "$ref": "#/$defs/DanoDeclarado" },
      "maxItems": 32
    },
    "evidencias": {
      "type": "array",
      "items": { "$ref": "#/$defs/EvidenciaFisica" },
      "maxItems": 64
    }
  },
  "$defs": {
    "Id": {
      "type": "string",
      "description": "Identificador estable dentro de la escena.",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
    },
    "Fuente": {
      "type": "string",
      "description": "De dónde salió el dato: del relato (con evidencia textual), lo escribió o corrigió la persona, lo supuso el sistema, o es el valor por defecto de la clase.",
      "enum": ["relato", "usuario", "supuesto", "default"]
    },
    "Confianza": {
      "type": "number",
      "description": "Confianza en el valor, de 0 (adivinado) a 1 (seguro).",
      "minimum": 0,
      "maximum": 1
    },
    "EvidenciaTexto": {
      "type": "object",
      "description": "Fragmento literal del relato que respalda el dato. Los offsets son índices de caracteres (inicio inclusivo, fin exclusivo) sobre el relato normalizado.",
      "additionalProperties": false,
      "required": ["inicio", "fin", "texto"],
      "properties": {
        "inicio": { "type": "integer", "minimum": 0 },
        "fin": { "type": "integer", "minimum": 1 },
        "texto": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "ListaEvidencia": {
      "type": "array",
      "items": { "$ref": "#/$defs/EvidenciaTexto" },
      "maxItems": 8
    },
    "Procedencia": {
      "type": "object",
      "description": "Procedencia de un objeto compuesto (pose, objeto del entorno, daño, evidencia) cuyos campos internos comparten origen.",
      "additionalProperties": false,
      "required": ["fuente", "confianza"],
      "properties": {
        "fuente": { "$ref": "#/$defs/Fuente" },
        "confianza": { "$ref": "#/$defs/Confianza" },
        "evidencia": { "$ref": "#/$defs/ListaEvidencia" },
        "nota": { "type": "string", "maxLength": 300 }
      }
    },
    "RangoNumerico": {
      "type": "array",
      "description": "Intervalo [mínimo, máximo] plausible en la misma unidad que valor.",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "CampoLongitud": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valor", "unidad", "fuente", "confianza"],
      "properties": {
        "valor": { "type": "number", "minimum": 0 },
        "unidad": { "type": "string", "enum": ["m", "cm", "mm", "km"] },
        "rango": { "$ref": "#/$defs/RangoNumerico" },
        "fuente": { "$ref": "#/$defs/Fuente" },
        "confianza": { "$ref": "#/$defs/Confianza" },
        "evidencia": { "$ref": "#/$defs/ListaEvidencia" },
        "nota": { "type": "string", "maxLength": 300 }
      }
    },
    "CampoVelocidad": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valor", "unidad", "fuente", "confianza"],
      "properties": {
        "valor": { "type": "number", "minimum": 0, "maximum": 400 },
        "unidad": { "type": "string", "enum": ["km/h", "m/s"] },
        "rango": { "$ref": "#/$defs/RangoNumerico" },
        "fuente": { "$ref": "#/$defs/Fuente" },
        "confianza": { "$ref": "#/$defs/Confianza" },
        "evidencia": { "$ref": "#/$defs/ListaEvidencia" },
        "nota": { "type": "string", "maxLength": 300 }
      }
    },
    "CampoMasa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valor", "unidad", "fuente", "confianza"],
      "properties": {
        "valor": { "type": "number", "exclusiveMinimum": 0 },
        "unidad": { "type": "string", "enum": ["kg", "t", "lb"] },
        "rango": { "$ref": "#/$defs/RangoNumerico" },
        "fuente": { "$ref": "#/$defs/Fuente" },
        "confianza": { "$ref": "#/$defs/Confianza" },
        "evidencia": { "$ref": "#/$defs/ListaEvidencia" },
        "nota": { "type": "string", "maxLength": 300 }
      }
    },
    "CampoTiempo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valor", "unidad", "fuente", "confianza"],
      "properties": {
        "valor": { "type": "number" },
        "unidad": { "type": "string", "enum": ["s", "ms", "min"] },
        "rango": { "$ref": "#/$defs/RangoNumerico" },
        "fuente": { "$ref": "#/$defs/Fuente" },
        "confianza": { "$ref": "#/$defs/Confianza" },
        "evidencia": { "$ref": "#/$defs/ListaEvidencia" },
        "nota": { "type": "string", "maxLength": 300 }
      }
    },
    "CampoAngulo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valor", "unidad", "fuente", "confianza"],
      "properties": {
        "valor": { "type": "number" },
        "unidad": { "type": "string", "enum": ["deg", "rad"] },
        "rango": { "$ref": "#/$defs/RangoNumerico" },
        "fuente": { "$ref": "#/$defs/Fuente" },
        "confianza": { "$ref": "#/$defs/Confianza" },
        "evidencia": { "$ref": "#/$defs/ListaEvidencia" },
        "nota": { "type": "string", "maxLength": 300 }
      }
    },
    "CampoAceleracion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valor", "unidad", "fuente", "confianza"],
      "properties": {
        "valor": { "type": "number" },
        "unidad": { "type": "string", "enum": ["m/s2", "g"] },
        "rango": { "$ref": "#/$defs/RangoNumerico" },
        "fuente": { "$ref": "#/$defs/Fuente" },
        "confianza": { "$ref": "#/$defs/Confianza" },
        "evidencia": { "$ref": "#/$defs/ListaEvidencia" },
        "nota": { "type": "string", "maxLength": 300 }
      }
    },
    "CampoPorcentaje": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valor", "unidad", "fuente", "confianza"],
      "properties": {
        "valor": { "type": "number", "minimum": -100, "maximum": 100 },
        "unidad": { "type": "string", "enum": ["%"] },
        "rango": { "$ref": "#/$defs/RangoNumerico" },
        "fuente": { "$ref": "#/$defs/Fuente" },
        "confianza": { "$ref": "#/$defs/Confianza" },
        "evidencia": { "$ref": "#/$defs/ListaEvidencia" },
        "nota": { "type": "string", "maxLength": 300 }
      }
    },
    "CampoAdimensional": {
      "type": "object",
      "description": "Magnitud sin unidad (p. ej. coeficiente de fricción).",
      "additionalProperties": false,
      "required": ["valor", "fuente", "confianza"],
      "properties": {
        "valor": { "type": "number" },
        "rango": { "$ref": "#/$defs/RangoNumerico" },
        "fuente": { "$ref": "#/$defs/Fuente" },
        "confianza": { "$ref": "#/$defs/Confianza" },
        "evidencia": { "$ref": "#/$defs/ListaEvidencia" },
        "nota": { "type": "string", "maxLength": 300 }
      }
    },
    "CampoEntero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valor", "fuente", "confianza"],
      "properties": {
        "valor": { "type": "integer" },
        "rango": { "$ref": "#/$defs/RangoNumerico" },
        "fuente": { "$ref": "#/$defs/Fuente" },
        "confianza": { "$ref": "#/$defs/Confianza" },
        "evidencia": { "$ref": "#/$defs/ListaEvidencia" },
        "nota": { "type": "string", "maxLength": 300 }
      }
    },
    "CampoBooleano": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valor", "fuente", "confianza"],
      "properties": {
        "valor": { "type": "boolean" },
        "fuente": { "$ref": "#/$defs/Fuente" },
        "confianza": { "$ref": "#/$defs/Confianza" },
        "evidencia": { "$ref": "#/$defs/ListaEvidencia" },
        "nota": { "type": "string", "maxLength": 300 }
      }
    },
    "CampoTexto": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valor", "fuente", "confianza"],
      "properties": {
        "valor": { "type": "string", "maxLength": 200 },
        "fuente": { "$ref": "#/$defs/Fuente" },
        "confianza": { "$ref": "#/$defs/Confianza" },
        "evidencia": { "$ref": "#/$defs/ListaEvidencia" },
        "nota": { "type": "string", "maxLength": 300 }
      }
    },
    "CampoTipoVia": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valor", "fuente", "confianza"],
      "properties": {
        "valor": {
          "type": "string",
          "enum": [
            "recta",
            "curva",
            "interseccion_x",
            "interseccion_t",
            "glorieta",
            "incorporacion",
            "retorno",
            "estacionamiento",
            "carretera_dos_carriles",
            "autopista"
          ]
        },
        "fuente": { "$ref": "#/$defs/Fuente" },
        "confianza": { "$ref": "#/$defs/Confianza" },
        "evidencia": { "$ref": "#/$defs/ListaEvidencia" },
        "nota": { "type": "string", "maxLength": 300 }
      }
    },
    "CampoSentidos": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valor", "fuente", "confianza"],
      "properties": {
        "valor": { "type": "string", "enum": ["un_sentido", "doble_sentido"] },
        "fuente": { "$ref": "#/$defs/Fuente" },
        "confianza": { "$ref": "#/$defs/Confianza" },
        "evidencia": { "$ref": "#/$defs/ListaEvidencia" },
        "nota": { "type": "string", "maxLength": 300 }
      }
    },
    "CampoSuperficie": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valor", "fuente", "confianza"],
      "properties": {
        "valor": {
          "type": "string",
          "enum": ["asfalto", "concreto", "adoquin", "empedrado", "terraceria"]
        },
        "fuente": { "$ref": "#/$defs/Fuente" },
        "confianza": { "$ref": "#/$defs/Confianza" },
        "evidencia": { "$ref": "#/$defs/ListaEvidencia" },
        "nota": { "type": "string", "maxLength": 300 }
      }
    },
    "CampoEstadoSuperficie": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valor", "fuente", "confianza"],
      "properties": {
        "valor": {
          "type": "string",
          "enum": ["seco", "mojado", "encharcado", "grava_suelta", "aceite", "lodo"]
        },
        "fuente": { "$ref": "#/$defs/Fuente" },
        "confianza": { "$ref": "#/$defs/Confianza" },
        "evidencia": { "$ref": "#/$defs/ListaEvidencia" },
        "nota": { "type": "string", "maxLength": 300 }
      }
    },
    "CampoClima": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valor", "fuente", "confianza"],
      "properties": {
        "valor": {
          "type": "string",
          "enum": ["despejado", "nublado", "lluvia_ligera", "lluvia_fuerte", "niebla", "granizo"]
        },
        "fuente": { "$ref": "#/$defs/Fuente" },
        "confianza": { "$ref": "#/$defs/Confianza" },
        "evidencia": { "$ref": "#/$defs/ListaEvidencia" },
        "nota": { "type": "string", "maxLength": 300 }
      }
    },
    "CampoIluminacion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valor", "fuente", "confianza"],
      "properties": {
        "valor": {
          "type": "string",
          "enum": ["dia", "amanecer", "atardecer", "noche_con_alumbrado", "noche_sin_alumbrado"]
        },
        "fuente": { "$ref": "#/$defs/Fuente" },
        "confianza": { "$ref": "#/$defs/Confianza" },
        "evidencia": { "$ref": "#/$defs/ListaEvidencia" },
        "nota": { "type": "string", "maxLength": 300 }
      }
    },
    "CampoClaseVehiculo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valor", "fuente", "confianza"],
      "properties": {
        "valor": {
          "type": "string",
          "enum": [
            "sedan_compacto",
            "sedan_mediano",
            "hatchback",
            "suv_compacta",
            "suv_grande",
            "pickup",
            "van",
            "microbus_combi",
            "autobus",
            "camion_unitario",
            "tractocamion",
            "motocicleta",
            "bicicleta",
            "scooter"
          ]
        },
        "fuente": { "$ref": "#/$defs/Fuente" },
        "confianza": { "$ref": "#/$defs/Confianza" },
        "evidencia": { "$ref": "#/$defs/ListaEvidencia" },
        "nota": { "type": "string", "maxLength": 300 }
      }
    },
    "CampoManiobra": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valor", "fuente", "confianza"],
      "properties": {
        "valor": {
          "type": "string",
          "enum": [
            "recto",
            "vuelta_izquierda",
            "vuelta_derecha",
            "vuelta_u",
            "cambio_carril_izquierda",
            "cambio_carril_derecha",
            "reversa",
            "incorporacion",
            "detenido",
            "estacionado"
          ]
        },
        "fuente": { "$ref": "#/$defs/Fuente" },
        "confianza": { "$ref": "#/$defs/Confianza" },
        "evidencia": { "$ref": "#/$defs/ListaEvidencia" },
        "nota": { "type": "string", "maxLength": 300 }
      }
    },
    "CampoEstadoPintura": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valor", "fuente", "confianza"],
      "properties": {
        "valor": { "type": "string", "enum": ["nueva", "normal", "desgastada"] },
        "fuente": { "$ref": "#/$defs/Fuente" },
        "confianza": { "$ref": "#/$defs/Confianza" },
        "evidencia": { "$ref": "#/$defs/ListaEvidencia" },
        "nota": { "type": "string", "maxLength": 300 }
      }
    },
    "CampoRolPersona": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valor", "fuente", "confianza"],
      "properties": {
        "valor": {
          "type": "string",
          "enum": ["conductor", "pasajero", "peaton", "ciclista", "motociclista"]
        },
        "fuente": { "$ref": "#/$defs/Fuente" },
        "confianza": { "$ref": "#/$defs/Confianza" },
        "evidencia": { "$ref": "#/$defs/ListaEvidencia" },
        "nota": { "type": "string", "maxLength": 300 }
      }
    },
    "CampoAsiento": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valor", "fuente", "confianza"],
      "properties": {
        "valor": {
          "type": "string",
          "enum": [
            "conductor",
            "copiloto",
            "trasero_izquierdo",
            "trasero_centro",
            "trasero_derecho",
            "tercera_fila",
            "otro"
          ]
        },
        "fuente": { "$ref": "#/$defs/Fuente" },
        "confianza": { "$ref": "#/$defs/Confianza" },
        "evidencia": { "$ref": "#/$defs/ListaEvidencia" },
        "nota": { "type": "string", "maxLength": 300 }
      }
    },
    "CampoPostura": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valor", "fuente", "confianza"],
      "properties": {
        "valor": {
          "type": "string",
          "enum": [
            "sentado",
            "de_pie",
            "caminando",
            "corriendo",
            "cruzando",
            "pedaleando",
            "en_moto",
            "tirado"
          ]
        },
        "fuente": { "$ref": "#/$defs/Fuente" },
        "confianza": { "$ref": "#/$defs/Confianza" },
        "evidencia": { "$ref": "#/$defs/ListaEvidencia" },
        "nota": { "type": "string", "maxLength": 300 }
      }
    },
    "Punto2D": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "number",
          "description": "Metros hacia el este desde el origen de la escena."
        },
        "y": {
          "type": "number",
          "description": "Metros hacia el norte desde el origen de la escena."
        }
      }
    },
    "Pose2D": {
      "type": "object",
      "description": "Posición y rumbo de un cuerpo en el plano. El rumbo se mide en grados desde +X (este) en sentido antihorario.",
      "additionalProperties": false,
      "required": ["x", "y", "rumbo_deg", "procedencia"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "rumbo_deg": { "type": "number", "minimum": -360, "maximum": 360 },
        "procedencia": { "$ref": "#/$defs/Procedencia" }
      }
    },
    "Color": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nombre", "hex"],
      "properties": {
        "nombre": { "$ref": "#/$defs/CampoTexto" },
        "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    },
    "Meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version_esquema", "idioma", "semilla", "creado"],
      "properties": {
        "id": { "type": "string", "minLength": 8, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$" },
        "version_esquema": { "type": "string", "const": "1.1.0" },
        "idioma": { "type": "string", "enum": ["es-MX", "en"] },
        "semilla": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Semilla de toda aleatoriedad (Monte Carlo, ragdolls, variación visual). Misma escena + misma semilla ⇒ misma reconstrucción."
        },
        "creado": { "type": "string", "format": "date-time" },
        "titulo": { "type": "string", "maxLength": 120 },
        "hash_relato": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 del relato normalizado. El texto completo solo vive en el dispositivo salvo consentimiento."
        },
        "relato": {
          "type": "string",
          "maxLength": 20000,
          "description": "Texto del relato con PII ya redactada. Opcional; solo presente en el dispositivo o con consentimiento."
        },
        "origen_relato": { "type": "string", "enum": ["escrito", "voz", "precargado", "manual"] },
        "sintetico": {
          "type": "boolean",
          "description": "Verdadero si la escena es un caso de prueba o demostración, no un percance real."
        }
      }
    },
    "FaseSemaforo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["movimiento", "color"],
      "properties": {
        "movimiento": {
          "type": "string",
          "description": "A qué flujo aplica: id de vehículo, o descripción como 'norte-sur'.",
          "maxLength": 60
        },
        "color": {
          "type": "string",
          "enum": ["verde", "amarillo", "rojo", "intermitente", "apagado"]
        },
        "tiempo_en_fase": { "$ref": "#/$defs/CampoTiempo" }
      }
    },
    "Dispositivo": {
      "type": "object",
      "description": "Dispositivo de control de tránsito.",
      "additionalProperties": false,
      "required": ["id", "tipo", "posicion", "procedencia"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "tipo": {
          "type": "string",
          "enum": [
            "semaforo",
            "alto",
            "ceda_el_paso",
            "tope",
            "paso_peatonal",
            "linea_continua",
            "linea_discontinua",
            "limite_velocidad",
            "no_vuelta",
            "un_sentido",
            "otro"
          ]
        },
        "posicion": { "$ref": "#/$defs/Punto2D" },
        "orientacion_deg": { "type": "number", "minimum": -360, "maximum": 360 },
        "aplica_a": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" },
          "maxItems": 8,
          "description": "Ids de vehículos a cuyo flujo aplica."
        },
        "fases": { "type": "array", "items": { "$ref": "#/$defs/FaseSemaforo" }, "maxItems": 8 },
        "limite_velocidad": { "$ref": "#/$defs/CampoVelocidad" },
        "procedencia": { "$ref": "#/$defs/Procedencia" }
      }
    },
    "UbicacionReal": {
      "type": "object",
      "description": "Coordenadas opcionales para generar la geometría desde OpenStreetMap (atribución ODbL en pantalla).",
      "additionalProperties": false,
      "required": ["lat", "lon", "procedencia"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "radio_m": { "type": "number", "minimum": 20, "maximum": 500 },
        "rotacion_deg": {
          "type": "number",
          "minimum": -360,
          "maximum": 360,
          "description": "Rotación aplicada al norte real para alinear con el eje de la escena."
        },
        "procedencia": { "$ref": "#/$defs/Procedencia" }
      }
    },
    "Lugar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tipo_via",
        "carriles_por_sentido",
        "ancho_carril",
        "sentidos",
        "superficie",
        "estado_superficie"
      ],
      "properties": {
        "nombre_via": { "$ref": "#/$defs/CampoTexto" },
        "nombre_via_secundaria": { "$ref": "#/$defs/CampoTexto" },
        "tipo_via": { "$ref": "#/$defs/CampoTipoVia" },
        "carriles_por_sentido": { "$ref": "#/$defs/CampoEntero" },
        "carriles_por_sentido_secundaria": { "$ref": "#/$defs/CampoEntero" },
        "ancho_carril": { "$ref": "#/$defs/CampoLongitud" },
        "sentidos": { "$ref": "#/$defs/CampoSentidos" },
        "camellon": { "$ref": "#/$defs/CampoBooleano" },
        "ancho_camellon": { "$ref": "#/$defs/CampoLongitud" },
        "banquetas": { "$ref": "#/$defs/CampoBooleano" },
        "guarniciones": { "$ref": "#/$defs/CampoBooleano" },
        "acotamiento": { "$ref": "#/$defs/CampoBooleano" },
        "ancho_acotamiento": { "$ref": "#/$defs/CampoLongitud" },
        "pendiente": { "$ref": "#/$defs/CampoPorcentaje" },
        "peralte": { "$ref": "#/$defs/CampoPorcentaje" },
        "radio_curva": { "$ref": "#/$defs/CampoLongitud" },
        "superficie": { "$ref": "#/$defs/CampoSuperficie" },
        "estado_superficie": { "$ref": "#/$defs/CampoEstadoSuperficie" },
        "friccion": { "$ref": "#/$defs/CampoAdimensional" },
        "dispositivos": {
          "type": "array",
          "items": { "$ref": "#/$defs/Dispositivo" },
          "maxItems": 32
        },
        "ubicacion_real": { "$ref": "#/$defs/UbicacionReal" }
      }
    },
    "ObjetoEntorno": {
      "type": "object",
      "description": "Objeto fijo o estacionado que puede ser golpeado o tapar la vista.",
      "additionalProperties": false,
      "required": ["id", "tipo", "posicion", "procedencia"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "tipo": {
          "type": "string",
          "enum": [
            "arbol",
            "poste",
            "muro",
            "barda",
            "vehiculo_estacionado",
            "puesto",
            "contenedor",
            "senal",
            "parada_autobus",
            "otro"
          ]
        },
        "posicion": { "$ref": "#/$defs/Punto2D" },
        "rumbo_deg": { "type": "number", "minimum": -360, "maximum": 360 },
        "largo": { "$ref": "#/$defs/CampoLongitud" },
        "ancho": { "$ref": "#/$defs/CampoLongitud" },
        "alto": { "$ref": "#/$defs/CampoLongitud" },
        "diametro_tronco": { "$ref": "#/$defs/CampoLongitud" },
        "material": {
          "type": "string",
          "enum": ["madera", "concreto", "metal", "mamposteria", "vegetal", "otro"]
        },
        "clase_vehiculo": { "$ref": "#/$defs/CampoClaseVehiculo" },
        "color": { "$ref": "#/$defs/Color" },
        "procedencia": { "$ref": "#/$defs/Procedencia" }
      }
    },
    "Entorno": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clima", "iluminacion"],
      "properties": {
        "fecha_hora": { "$ref": "#/$defs/CampoTexto" },
        "clima": { "$ref": "#/$defs/CampoClima" },
        "visibilidad": { "$ref": "#/$defs/CampoLongitud" },
        "iluminacion": { "$ref": "#/$defs/CampoIluminacion" },
        "alumbrado_publico": { "$ref": "#/$defs/CampoBooleano" },
        "temperatura_c": { "$ref": "#/$defs/CampoAdimensional" },
        "objetos": { "type": "array", "items": { "$ref": "#/$defs/ObjetoEntorno" }, "maxItems": 64 }
      }
    },
    "Frenado": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aplico"],
      "properties": {
        "aplico": { "$ref": "#/$defs/CampoBooleano" },
        "distancia_antes_impacto": { "$ref": "#/$defs/CampoLongitud" },
        "abs": { "$ref": "#/$defs/CampoBooleano" },
        "bloqueo_llantas": { "$ref": "#/$defs/CampoBooleano" }
      }
    },
    "Vehiculo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rol",
        "clase",
        "color",
        "maniobra",
        "velocidad_previa",
        "posicion_inicial"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "rol": {
          "type": "string",
          "pattern": "^[A-H]$",
          "description": "Letra con la que se nombra en el croquis (A, B, C…)."
        },
        "clase": { "$ref": "#/$defs/CampoClaseVehiculo" },
        "marca": { "$ref": "#/$defs/CampoTexto" },
        "modelo": { "$ref": "#/$defs/CampoTexto" },
        "anio": { "$ref": "#/$defs/CampoEntero" },
        "color": { "$ref": "#/$defs/Color" },
        "estado_pintura": { "$ref": "#/$defs/CampoEstadoPintura" },
        "masa": { "$ref": "#/$defs/CampoMasa" },
        "largo": { "$ref": "#/$defs/CampoLongitud" },
        "ancho": { "$ref": "#/$defs/CampoLongitud" },
        "alto": { "$ref": "#/$defs/CampoLongitud" },
        "distancia_entre_ejes": { "$ref": "#/$defs/CampoLongitud" },
        "voladizo_delantero": { "$ref": "#/$defs/CampoLongitud" },
        "voladizo_trasero": { "$ref": "#/$defs/CampoLongitud" },
        "maniobra": { "$ref": "#/$defs/CampoManiobra" },
        "velocidad_previa": { "$ref": "#/$defs/CampoVelocidad" },
        "frenado": { "$ref": "#/$defs/Frenado" },
        "aceleracion": { "$ref": "#/$defs/CampoAceleracion" },
        "luces_encendidas": { "$ref": "#/$defs/CampoBooleano" },
        "direccionales": {
          "type": "string",
          "enum": ["ninguna", "izquierda", "derecha", "intermitentes"]
        },
        "carril": { "$ref": "#/$defs/CampoEntero" },
        "posicion_inicial": { "$ref": "#/$defs/Pose2D" },
        "posicion_final": { "$ref": "#/$defs/Pose2D" },
        "ocupantes": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" },
          "maxItems": 60,
          "description": "Ids de personas a bordo."
        }
      }
    },
    "Persona": {
      "type": "object",
      "description": "Persona involucrada. Nunca lleva nombre ni datos de contacto.",
      "additionalProperties": false,
      "required": ["id", "rol"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "rol": { "$ref": "#/$defs/CampoRolPersona" },
        "vehiculo_id": { "$ref": "#/$defs/Id" },
        "asiento": { "$ref": "#/$defs/CampoAsiento" },
        "edad_aprox": { "$ref": "#/$defs/CampoEntero" },
        "estatura": { "$ref": "#/$defs/CampoLongitud" },
        "masa": { "$ref": "#/$defs/CampoMasa" },
        "cinturon": { "$ref": "#/$defs/CampoBooleano" },
        "casco": { "$ref": "#/$defs/CampoBooleano" },
        "sistema_retencion_infantil": { "$ref": "#/$defs/CampoBooleano" },
        "postura": { "$ref": "#/$defs/CampoPostura" },
        "direccion_movimiento": { "$ref": "#/$defs/CampoAngulo" },
        "velocidad": { "$ref": "#/$defs/CampoVelocidad" },
        "posicion_inicial": { "$ref": "#/$defs/Pose2D" },
        "posicion_final": { "$ref": "#/$defs/Pose2D" }
      }
    },
    "ZonaCDC": {
      "type": "object",
      "description": "Zona de daño con la convención CDC (SAE J224): lado del vehículo, zona horizontal, zona vertical y extensión.",
      "additionalProperties": false,
      "required": ["lado"],
      "properties": {
        "lado": {
          "type": "string",
          "enum": ["F", "B", "L", "R", "T", "U"],
          "description": "F frente, B atrás, L izquierda, R derecha, T techo, U bajos."
        },
        "zona_horizontal": {
          "type": "string",
          "enum": ["L", "C", "R", "Y", "Z", "D", "F", "P", "B"],
          "description": "Para F/B: L izquierda, C centro, R derecha, Y izq+centro, Z centro+der, D distribuido. Para L/R: F delantera, P pasajeros, B trasera, Y, Z, D."
        },
        "zona_vertical": {
          "type": "string",
          "enum": ["A", "E", "G", "H", "L", "M", "W"],
          "description": "A todo, E todo salvo bajos, G bajos y carrocería, H cofre/cajuela, L defensa, M carrocería media, W parabrisas/ventanas."
        },
        "extension": { "type": "integer", "minimum": 1, "maximum": 9 }
      }
    },
    "Evento": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "orden", "tipo", "actores", "procedencia"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "orden": { "type": "integer", "minimum": 0, "maximum": 99 },
        "tipo": {
          "type": "string",
          "enum": [
            "inicio_frenado",
            "impacto_vehiculo_vehiculo",
            "impacto_vehiculo_objeto",
            "impacto_vehiculo_persona",
            "giro",
            "derrape",
            "volcadura",
            "arrastre",
            "segundo_impacto",
            "reposo"
          ]
        },
        "t": { "$ref": "#/$defs/CampoTiempo" },
        "actores": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" },
          "minItems": 1,
          "maxItems": 8,
          "description": "Ids de vehículos, personas u objetos que participan."
        },
        "zonas_impacto": {
          "type": "array",
          "items": { "$ref": "#/$defs/ZonaImpacto" },
          "maxItems": 8
        },
        "pdof_horas": { "$ref": "#/$defs/CampoAdimensional" },
        "punto_impacto": { "$ref": "#/$defs/Punto2D" },
        "descripcion": { "type": "string", "maxLength": 400 },
        "procedencia": { "$ref": "#/$defs/Procedencia" }
      }
    },
    "ZonaImpacto": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vehiculo_id", "cdc"],
      "properties": {
        "vehiculo_id": { "$ref": "#/$defs/Id" },
        "cdc": { "$ref": "#/$defs/ZonaCDC" },
        "pdof_horas": { "$ref": "#/$defs/CampoAdimensional" }
      }
    },
    "DanoDeclarado": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vehiculo_id", "zona", "severidad", "procedencia"],
      "properties": {
        "vehiculo_id": { "$ref": "#/$defs/Id" },
        "zona": { "$ref": "#/$defs/ZonaCDC" },
        "severidad": {
          "type": "string",
          "enum": ["ninguno", "leve", "moderado", "severo", "perdida_total"]
        },
        "profundidad_aplastamiento": { "$ref": "#/$defs/CampoLongitud" },
        "ancho_danado": { "$ref": "#/$defs/CampoLongitud" },
        "vidrios": { "type": "string", "enum": ["intactos", "estrellados", "rotos"] },
        "bolsas_aire": { "$ref": "#/$defs/CampoBooleano" },
        "piezas_desprendidas": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "defensa",
              "espejo",
              "faro",
              "calavera",
              "cofre",
              "puerta",
              "llanta",
              "tapon",
              "moldura",
              "placa",
              "otra"
            ]
          },
          "maxItems": 11
        },
        "fugas": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["anticongelante", "aceite", "combustible", "ninguna"]
          },
          "maxItems": 4
        },
        "descripcion": { "type": "string", "maxLength": 400 },
        "procedencia": { "$ref": "#/$defs/Procedencia" }
      }
    },
    "EvidenciaFisica": {
      "type": "object",
      "description": "Huella física o testimonio que restringe la reconstrucción.",
      "additionalProperties": false,
      "required": ["id", "tipo", "procedencia"],
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "tipo": {
          "type": "string",
          "enum": [
            "marcas_frenado",
            "marcas_derrape",
            "restos",
            "vidrios",
            "posicion_final",
            "distancia_proyeccion",
            "testigo",
            "foto",
            "video",
            "otra"
          ]
        },
        "vehiculo_id": { "$ref": "#/$defs/Id" },
        "persona_id": { "$ref": "#/$defs/Id" },
        "longitud": { "$ref": "#/$defs/CampoLongitud" },
        "fase": {
          "type": "string",
          "enum": ["antes_impacto", "despues_impacto"],
          "description": "Si las marcas quedaron antes o después del impacto (desde 1.1.0). Sin este campo, unas marcas_frenado se toman como de antes del impacto (la convención de 1.0.0) y unas marcas_derrape tienen fase desconocida y el solver no las usa."
        },
        "puntos": { "type": "array", "items": { "$ref": "#/$defs/Punto2D" }, "maxItems": 64 },
        "descripcion": { "type": "string", "maxLength": 400 },
        "procedencia": { "$ref": "#/$defs/Procedencia" }
      }
    }
  }
}
