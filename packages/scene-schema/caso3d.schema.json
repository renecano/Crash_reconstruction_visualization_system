          },
          "minItems": 3
        },
        "amplitud_m": {
          "type": "number"
        },
        "longitud_onda_m": {
          "type": "number"
        },
        "rumbo_deg": {
          "type": "number"
        }
      }
    },
    "TopeEscenario": {
      "title": "TopeEscenario",
      "description": "Un tope: la línea que cruza la vía, su alto y su largo en el sentido de la marcha.",
      "type": "object",
      "additionalProperties": false,
      "required": ["ax", "ay", "bx", "by", "alto_m", "largo_m"],
      "properties": {
        "ax": {
          "type": "number"
        },
        "ay": {
          "type": "number"
        },
        "bx": {
          "type": "number"
        },
        "by": {
          "type": "number"
        },
        "alto_m": {
          "type": "number"
        },
        "largo_m": {
          "type": "number"
        }
      }
    },
    "TerrenoEscenario": {
      "title": "TerrenoEscenario",
      "description": "El terreno de C3 que declara la escena (`lugar.terreno`), para dibujarlo. La malla de relieve viaja aparte, en `relieve`.",
      "type": "object",
      "additionalProperties": false,
      "required": ["superficies", "ondulaciones", "topes"],
      "properties": {
        "superficies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SuperficieEscenario"
          }
        },
        "ondulaciones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OndulacionEscenario"
          }
        },
