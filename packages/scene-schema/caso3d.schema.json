      "additionalProperties": false,
      "required": ["tipo", "poligono"],
      "properties": {
        "tipo": {
          "title": "TipoSuperficie",
          "type": "string",
          "enum": [
            "asfalto",
            "concreto",
            "adoquin",
            "empedrado",
            "terraceria",
            "grava",
            "pasto",
            "tierra",
            "lodo"
          ]
        },
        "poligono": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PuntoPlano"
          },
          "minItems": 3
        }
      }
