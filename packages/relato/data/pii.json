{
  "version": "1.0.0",
  "descripcion": "Patrones y pistas del redactor de datos personales. Los usan igual la referencia Python (re con ASCII) y el port TS (RegExp sin bandera u): solo \\d, \\s, \\w y \\b ASCII, lookbehind de ancho fijo y sin banderas en línea. 'vista': 'original' corre sobre el texto con espacios Unicode normalizados; 'plegado', sobre el texto plegado (minúsculas, sin acentos, misma longitud).",
  "patrones": [
    {
      "tipo": "CORREO",
      "vista": "original",
      "regex": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}"
    },
    {
      "tipo": "CURP",
      "vista": "original",
      "regex": "(?<![A-Za-z0-9_ÁÉÍÓÚÜÑáéíóúüñ])[A-Z]{4}\\d{6}[HM][A-Z]{5}[A-Z0-9]\\d(?![A-Za-z0-9_])"
    },
    {
      "tipo": "RFC",
      "vista": "original",
      "regex": "(?<![A-Za-z0-9_ÁÉÍÓÚÜÑáéíóúüñ])[A-ZÑ&]{3,4}\\d{6}[A-Z0-9]{3}(?![A-Za-z0-9_])"
    },
    {
      "tipo": "TELEFONO",
      "vista": "original",
      "regex": "(?<![\\w])(?:\\+?52[\\s.-]?)?(?:\\(?\\d{2,3}\\)?[\\s.-]?)?\\d{3,4}[\\s.-]?\\d{4}(?![\\w])",
      "digitos": [10, 12]
    },
    {
      "tipo": "PLACA",
      "vista": "plegado",
      "regex": "(?<![\\w])(?:[a-z]{3}[\\s-]?\\d{3}[\\s-]?[a-z]|[a-z]{3}[\\s-]?\\d{2}[\\s-]?\\d{2}|\\d{3}[\\s-]?[a-z]{3}|[a-z]{2}[\\s-]?\\d{2}[\\s-]?\\d{3}|[a-z]\\d{2}[\\s-]?[a-z]{3}|\\d{2}[\\s-]?[a-z]{2}[\\s-]?\\d{2}|[a-z]{3}[\\s-]?\\d{4})(?![\\w])",
      "mixto": true
    },
    {
      "tipo": "PLACA",
      "vista": "plegado",
      "regex": "(?<=placas)(?:\\s+(?:de|con|numero|son|eran))?[\\s:]*((?=[a-z0-9-]*\\d)[a-z0-9][a-z0-9-]{2,9})"
    },
    {
      "tipo": "PLACA",
      "vista": "plegado",
      "regex": "(?<=placa)(?:\\s+(?:de|con|numero|es|era))?[\\s:]*((?=[a-z0-9-]*\\d)[a-z0-9][a-z0-9-]{2,9})"
    },
    {
      "tipo": "NUMERO",
      "vista": "plegado",
      "regex": "(?<![\\w])(?:numero|num\\.?|no\\.|#)\\s*\\d{1,5}(?![\\s.-]?\\d)[a-z]?(?:\\s*(?:int(?:erior)?\\.?|depto\\.?|departamento)\\s*[a-z0-9-]+)?"
    }
  ],
