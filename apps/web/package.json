{
  "name": "@croquis/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-worker.mjs && next dev",
    "build": "node scripts/build-worker.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "paginas": "node scripts/build-paginas.mjs",
    "marca": "node scripts/tokens.mjs && node scripts/iconos.mjs",
    "generate:check": "node scripts/build-paginas.mjs --check && node scripts/tokens.mjs --check && node scripts/iconos.mjs --check && node scripts/portada.mjs --check",
    "portada": "node scripts/portada.mjs"
  },
  "dependencies": {
    "@croquis/croquis-2d": "workspace:*",
    "@croquis/extraction": "workspace:*",
    "@croquis/scene-schema": "workspace:*",
    "@croquis/solver-ts": "workspace:*",
    "@croquis/viewer": "workspace:*",
    "@fontsource-variable/anybody": "5.3.0",
    "next": "16.4.0",
    "pdfmake": "0.3.11",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@serwist/turbopack": "9.5.13",
    "@tailwindcss/turbopack": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/pdfmake": "0.3.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "esbuild": "0.28.2",
    "eslint": "catalog:",
    "eslint-config-next": "16.4.0",
    "fast-check": "catalog:",
    "jsdom": "catalog:",
    "mediabunny": "1.61.6",
    "pdfjs-dist": "6.4.299",
    "serwist": "9.5.13",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
