# Copia este archivo a .env.local (web) o .env (api). Nunca versiones secretos.

# --- API de Claude (services/api, extraction) ---
ANTHROPIC_API_KEY=
# Modelo por defecto para extracción; comparar contra claude-haiku-5-5 (PLAN §5.1)
CROQUIS_LLM_MODEL=claude-sonnet-5-5
# Tope de gasto por día en USD para la API (PLAN §16.4). 0 desactiva las llamadas.
CROQUIS_LLM_DAILY_BUDGET_USD=2
# Peticiones máximas por usuario por hora
CROQUIS_LLM_RATE_LIMIT_PER_HOUR=20
# Peticiones por hora a /reconstruir con analisis (Monte Carlo, inversión y consistencia)
CROQUIS_ANALYSIS_RATE_LIMIT_PER_HOUR=30
# Orígenes permitidos para la web (CORS), separados por comas
CROQUIS_CORS_ORIGINS=http://localhost:3000
# Modo del cliente de Claude en extraction: replay (CI, por omisión), record (grabar E1) o live
CROQUIS_LLM_MODO=replay

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Infra (infra/) ---
AWS_REGION=us-east-1
