# Copia este archivo a .env.local (raíz o apps/web). Nunca versiones secretos.
# En Vercel, estas variables se configuran en el proyecto (Settings → Environment Variables).

# --- Claude (Route Handlers de apps/web y scripts de packages/extraction) ---
ANTHROPIC_API_KEY=
# Modelo por defecto para extracción; comparar contra claude-haiku-5-5 (PLAN §5.1)
CROQUIS_LLM_MODEL=claude-sonnet-5-5
# Tope de gasto por día en USD para la API (PLAN §16.4). 0 desactiva las llamadas.
CROQUIS_LLM_DAILY_BUDGET_USD=2
# Peticiones máximas por usuario por hora
CROQUIS_LLM_RATE_LIMIT_PER_HOUR=20
# Modo del cliente de Claude en los scripts y la referencia Python: replay (CI, por omisión),
# record (grabar E1) o live. Las rutas de la web siempre usan live.
CROQUIS_LLM_MODO=replay

# --- Upstash Redis (Marketplace de Vercel): tope de gasto y límite de peticiones ---
# Sin estas variables, en Vercel la extracción usa la línea base de reglas (no hay dónde llevar
# el gasto); en local el gasto se lleva en packages/extraction/grabaciones/gasto.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
