# Dependencias
node_modules/
.pnp
.pnp.*

# Next.js
.next/
out/
next-env.d.ts

# Compilados
dist/
build/
*.tsbuildinfo

# Pruebas
coverage/
.vitest/
playwright-report/
test-results/
.pytest_cache/
.hypothesis/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Datos crudos: se descargan con los scripts de data/scripts (ver data/SOURCES.md)
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md

# Secretos
.env
.env.*
!.env.example

# Despliegue
.vercel
cdk.out/

# Sistema
.DS_Store
Thumbs.db
*.log

# Relatos-MX publicado (derivado, verificado en CI con croquis-extraction relatos check)
!data/relatos-mx/build/

# Candado y temporales del libro de gasto (grabadores en paralelo)
packages/extraction/grabaciones/*.lock
packages/extraction/grabaciones/*.tmp

# Worker del solver empaquetado antes de next build (ADR 0030)
apps/web/public/workers/
# Worker de MapLibre copiado de node_modules en cada build (scripts/maplibre-worker.mjs)
apps/web/public/maplibre/

# Casos de E5 exportados para el reproductor en TS (se regeneran con croquis-eval e5-casos)
eval/e5/casos.jsonl
# Resultado por caso del desarrollo de E5 (para el ajuste; se regenera con el reproductor)
eval/e5/resultados_desarrollo.jsonl

# Video demo (demo/video): lo generado se queda fuera de git; el MP4 final pesa más de 20 MB
demo/video/salida/
demo/video/*.mp4
demo/video/*.srt
# Worker de pdf.js copiado de node_modules en cada build (scripts/pdfjs-worker.mjs)
apps/web/public/pdfjs/
