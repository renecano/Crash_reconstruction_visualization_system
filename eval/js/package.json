{
  "name": "@croquis/eval-js",
  "version": "0.1.0",
  "private": true,
  "description": "Evaluaciones en TypeScript que usan el visor (ragdoll) y el port del solver",
  "type": "module",
  "scripts": {
    "ragdoll": "tsx ragdoll_searle.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "e5": "tsx e5_dano.ts",
    "test": "vitest run",
    "e5:galeria": "tsx e5_galeria.ts && prettier --write ../../docs/galeria-e5/README.md"
  },
  "dependencies": {
    "@croquis/scene-schema": "workspace:*",
    "@croquis/solver-ts": "workspace:*",
    "@croquis/viewer": "workspace:*",
    "three": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/three": "catalog:",
    "esbuild": "0.28.2",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
